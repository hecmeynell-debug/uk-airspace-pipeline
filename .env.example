# ---------------------------------------------------------------------------
# Local development configuration. Copy to .env and edit.
#   cp .env.example .env
# .env is git-ignored. These values are for LOCAL DOCKER ONLY - never reuse
# them anywhere that is reachable from a network.
# ---------------------------------------------------------------------------

# --- Postgres (superuser / bootstrap) --------------------------------------
POSTGRES_DB=airspace
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local_dev_only_change_me
# Host port. Bound to 127.0.0.1 in docker-compose.yml, not 0.0.0.0.
POSTGRES_PORT=5432

# --- Least-privilege application roles -------------------------------------
# Created by db/init/01_roles_and_schemas.sh on first container start.
# Keep these alphanumeric/underscore for local dev.
AIRSPACE_OWNER_PASSWORD=owner_local_dev_pw
AIRSPACE_INGEST_PASSWORD=ingest_local_dev_pw
AIRSPACE_TRANSFORM_PASSWORD=transform_local_dev_pw
AIRSPACE_READER_PASSWORD=reader_local_dev_pw

# --- OpenSky Network API ---------------------------------------------------
# OAuth2 client-credentials only; username/password basic auth is no longer
# accepted. Register at https://opensky-network.org and create an API client.
# Leave BOTH blank to run anonymously (400 credits/day, 10s resolution,
# live state vectors only - no historical `time` parameter).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_TOKEN_URL=https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token
OPENSKY_API_BASE=https://opensky-network.org/api

# --- Bounded region of interest --------------------------------------------
# UK FIRs (London + Scottish) plus a margin of the eastern North Atlantic.
# Area = (LAT_MAX-LAT_MIN) * (LON_MAX-LON_MIN) = 12 * 13 = 156 sq deg
#   -> 3 API credits per /states/all call (100-400 sq deg band).
# See docs/adrs/0001-opensky-and-overall-architecture.md for the credit budget.
OPENSKY_LAT_MIN=49.0
OPENSKY_LAT_MAX=61.0
OPENSKY_LON_MIN=-10.0
OPENSKY_LON_MAX=3.0

# Poll cadence. 120s * 3 credits = 2160 credits/day, ~54% of the 4000/day
# authenticated allowance, leaving headroom for retries and backfills.
POLL_INTERVAL_SECONDS=120

# --- Observability ---------------------------------------------------------
LOG_LEVEL=INFO
